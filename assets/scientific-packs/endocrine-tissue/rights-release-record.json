        {
          "id": "parathyroid_cords",
          "citation": "Gilmour JR. The normal histology of the parathyroid glands. J Pathol Bacteriol. 1939;48:187–222.",
          "doi": "10.1002/path.1700480119",
          "url": "https://doi.org/10.1002/path.1700480119",
          "design_decision": "Supports parenchymal chief-cell fields and connective tissue; a separately visible capillary is included as a generic structural relationship."
        },
        {
          "id": "pancreatic_islet",
          "citation": "Cabrera O, et al. The unique cytoarchitecture of human pancreatic islets has implications for islet cell function. Proc Natl Acad Sci USA. 2006;103:2334–2339.",
          "doi": "10.1073/pnas.0510790103",
          "url": "https://doi.org/10.1073/pnas.0510790103",
          "design_decision": "Shows mixed human endocrine cell types associated with microvasculature; avoids imposing a universal rodent core–mantle pattern."
        },
        {
          "id": "adrenal_zones",
          "citation": "Fu R, et al. In Situ Spatial Reconstruction of Distinct Normal and Pathological Cell Populations Within the Human Adrenal Gland. J Endocr Soc. 2023;7:bvad131.",
          "doi": "10.1210/jendso/bvad131",
          "url": "https://doi.org/10.1210/jendso/bvad131",
          "design_decision": "Human spatial reconstruction supports the outward-to-inward order of capsule, zona glomerulosa, zona fasciculata, zona reticularis, and medulla."
        },
        {
          "id": "adrenal_medulla",
          "citation": "Kikuta A, Murakami T. Relationship between chromaffin cells and blood vessels in the rat adrenal medulla: a transmission electron microscopic study combined with blood vessel reconstructions. Am J Anat. 1984;170:73–81.",
          "doi": "10.1002/aja.1001700106",
          "url": "https://doi.org/10.1002/aja.1001700106",
          "design_decision": "Directly supports close relationships between chromaffin cells and sinusoidal vascular channels; rat-specific vascular anatomy is presented schematically."
        },
        {
          "id": "pineal_vasculature",
          "citation": "Murakami T, Kikuta A, Taguchi T, Ohtsuka A. The blood vascular architecture of the rat pineal gland: a scanning electron microscopic study of corrosion casts. Arch Histol Cytol. 1988;51:61–69.",
          "doi": "10.1679/aohc.51.61",
          "url": "https://doi.org/10.1679/aohc.51.61",
          "design_decision": "Supports a richly interconnected capillary network. A separate human postmortem morphometry reference supports pinealocytes within glial tissue; no calcification is implied."
        },
        {
          "id": "pineal_parenchyma",
