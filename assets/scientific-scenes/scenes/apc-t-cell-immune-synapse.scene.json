{
  "schema": "figureStudio.scientificScene.v1",
  "id": "apc-t-cell-immune-synapse",
  "name": "APC–T-cell immune synapse",
  "summary": "Opposing APC and T-cell membranes with antigen recognition, CD28 costimulation, PD-1 checkpoint context, and a bounded signaling handoff.",
  "source_record_id": "source.figure-studio-apc-tcell-immune-synapse.2026-09-12",
  "rights_record_id": "rights.figure-studio-apc-tcell-immune-synapse.cc0.2026-09-12",
  "scientific_record": {
    "id": "science.figure-studio.apc-t-cell-immune-synapse.2026-09-12",
    "verified_on": "2026-09-12",
    "scope": "A locally authored, editable orientation schematic of an antigen-presenting-cell–T-cell interface with selected recognition, costimulatory, checkpoint, and proximal-signaling relationships.",
    "relationships": [
      {
        "claim": "The immune synapse is represented as a specialized interface between an antigen-presenting cell and a T cell, with peptide–MHC/TCR recognition shown at the contact.",
        "source_ids": ["grakoui-1999", "courtney-2018"]
      },
      {
        "claim": "CD28 engagement by B7-family ligands is represented as a costimulatory input alongside antigen recognition.",
        "source_ids": ["esensten-2016"]
      },
      {
        "claim": "PD-1/PD-L1 engagement is shown as checkpoint context that can recruit SHP2 and preferentially attenuate CD28 signaling in the experimental systems studied.",
        "source_ids": ["yokosuka-2012", "hui-2017"]
      },
      {
        "claim": "LCK, ZAP-70, and LAT are shown only as a selected proximal handoff downstream of TCR engagement.",
        "source_ids": ["courtney-2018"]
      }
    ],
    "sources": [
      {
        "id": "grakoui-1999",
        "citation": "Grakoui A et al. The immunological synapse: a molecular machine controlling T cell activation. Science. 1999;285:221–227.",
        "doi": "10.1126/science.285.5425.221",
        "url": "https://pubmed.ncbi.nlm.nih.gov/10398592/",
        "role": "Primary experimental precedent for treating the APC–T-cell contact as an organized immune-synapse interface. The starter does not reproduce its concentric molecular pattern or kinetics."
      },
      {
        "id": "courtney-2018",
        "citation": "Courtney AH, Lo W-L, Weiss A. TCR Signaling: Mechanisms of Initiation and Propagation. Trends Biochem Sci. 2018;43:108–123.",
        "doi": "10.1016/j.tibs.2017.11.008",
        "url": "https://pubmed.ncbi.nlm.nih.gov/29269020/",
        "role": "Authoritative review supporting the selected TCR–LCK–ZAP-70–LAT proximal handoff."
      },
      {
        "id": "esensten-2016",
        "citation": "Esensten JH et al. CD28 costimulation: from mechanism to therapy. Immunity. 2016;44:973–988.",
        "doi": "10.1016/j.immuni.2016.04.020",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4932896/",
        "role": "Authoritative review supporting CD28–B7 costimulation as a parallel input to antigen recognition."
      },
      {
        "id": "yokosuka-2012",
        "citation": "Yokosuka T et al. Programmed cell death 1 forms negative costimulatory microclusters that directly inhibit T cell receptor signaling by recruiting phosphatase SHP2. J Exp Med. 2012;209:1201–1217.",
        "doi": "10.1084/jem.20112741",
        "url": "https://rupress.org/jem/article/209/6/1201/41299/Programmed-cell-death-1-forms-negative",
        "role": "Primary experimental evidence for PD-1 microclusters, SHP2 recruitment, and proximal inhibitory context."
      },
      {
        "id": "hui-2017",
        "citation": "Hui E et al. T cell costimulatory receptor CD28 is a primary target for PD-1-mediated inhibition. Science. 2017;355:1428–1433.",
        "doi": "10.1126/science.aaf1292",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6286077/",
        "role": "Primary biochemical and intact-cell evidence that CD28 is preferentially dephosphorylated by PD-1-recruited SHP2 in the tested systems."
      }
    ],
    "design_precedents": [
      {
        "source_id": "grakoui-1999",
        "figure": "Experimental synapse series",
        "decision": "Make the APC–T-cell interface the visual anchor while avoiding a claim that this orientation schematic reproduces a mature concentric synapse."
      },
      {
        "source_id": "courtney-2018",
        "figure": "Figure 1B",
        "decision": "Keep the LCK–ZAP-70–LAT handoff compact and visually subordinate to receptor engagement."
      },
      {
        "source_id": "esensten-2016",
        "figure": "Conceptual pathway discussion",
        "decision": "Show CD28–B7 costimulation alongside peptide–MHC/TCR recognition rather than as a downstream TCR node."
      },
      {
        "source_id": "yokosuka-2012",
        "figure": "Figures 6–8",
        "decision": "Use a distinct PD-1/SHP2 branch and an inhibition-bar terminator without implying therapy or response magnitude."
      },
      {
        "source_id": "hui-2017",
        "figure": "Figures 2–3",
        "decision": "Aim the qualified checkpoint branch toward CD28 and state that the preference is specific to the cited experimental systems."
      }
    ],
    "limitations": [
      "This starter is a qualitative orientation schematic, not a canonical or complete immune-synapse receptor catalog.",
      "Relationships are not quantitative, stoichiometric, kinetic, temporal, or causal-inference claims.",
      "The side-by-side overview and separated contact details do not claim molecular scale, abundance, colocalization, simultaneous occupancy, or a mature concentric synapse pattern.",
      "APC subtype, T-cell lineage or state, MHC class, peptide identity, ligand density, species, and experimental context are intentionally unspecified.",
      "The LCK–ZAP-70–LAT sequence is a selected proximal handoff, not a complete or computable signaling pathway.",
      "The PD-1/SHP2-to-CD28 relationship is limited to the cited experimental contexts and is not a clinical or treatment-response claim."
    ],
    "authorship": "Original Figure Studio scene recipe and preview assembled from already released Figure Studio vector assets and original primitives; no third-party artwork, database diagram, or commercial visual content was copied, traced, or embedded."
  },
