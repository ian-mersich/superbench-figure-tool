    "verified_on": "2026-11-03",
    "scope": "Fixed-cell labeling with a target-specific primary antibody and fluorophore-linked secondary antibody.",
    "relationships": [
      {
        "claim": "The primary antibody recognizes the selected target; a fluorophore-conjugated secondary antibody binds the primary antibody for imaging.",
        "source_ids": [
          "donaldson-2001",
          "yong-2019"
        ]
      }
    ],
    "sources": [
      {
        "id": "donaldson-2001",
        "citation": "Donaldson JG. UNIT 4.3 Immunofluorescence Staining. Curr Protoc Cell Biol. 2001;0(4):Unit 4.3.",
        "doi": "10.1002/0471143030.cb0403s00",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4709840/",
        "support_location": "Protocol sequence for blocking and antibody incubation.",
        "decision": "Use the indirect-labeling sequence and separate staining from image acquisition; depict controls as a visible check rather than implying that a fluorescent signal is target-specific by itself."
      },
      {
        "id": "yong-2019",
        "citation": "Im K, Mareninov S, Diaz MF, Yong WH. An Introduction to Performing Immunofluorescence Staining. Methods Mol Biol. 2019;1897:299–311.",
        "doi": "10.1007/978-1-4939-8935-5_26",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6918834/",
        "support_location": "Sections 3.4.1 Blocking and 3.4.2 Antibody and Biotin-Streptavidin Incubation; Figure 2 shows indirect immunofluorescence.",
        "decision": "Use the indirect-labeling sequence and separate staining from image acquisition; depict controls as a visible check rather than implying that a fluorescent signal is target-specific by itself."
      }
    ],
    "limitations": [
      "Schematic only. Localization and signal are not data. Fixation, permeabilization, antibody specificity, fluorophore cross-reactivity, spectral bleed-through, and imaging settings require validation; include appropriate negative controls."
    ],
