{
  "schema": "figureStudio.scientificScene.v1",
  "id": "immunoblot-assay-workflow",
  "name": "Immunoblot assay workflow",
  "summary": "An editable immunoblot workflow from sample collection and lysis through SDS-PAGE, membrane transfer, antibody probing, signal detection, and one illustrative target/loading-control result.",
  "source_record_id": "source.figure-studio-immunoblot-assay-workflow.2026-09-13",
  "rights_record_id": "rights.figure-studio-immunoblot-assay-workflow.cc0.2026-09-13",
  "scientific_record": {
    "id": "science.figure-studio.immunoblot-assay-workflow.2026-09-13",
    "verified_on": "2026-09-13",
    "scope": "A locally authored, editable orientation schematic of one ordinary immunoblot workflow from sample preparation through an illustrative target and loading-control result.",
    "relationships": [
      {
        "claim": "A conventional immunoblot workflow can proceed from sample collection and lysate preparation through protein separation by SDS-PAGE, transfer to a membrane, blocking, primary and secondary antibody probing, and signal detection.",
        "source_ids": ["bass-2017", "towbin-1979"]
      },
      {
        "claim": "Total-protein assessment informs planned loading, but equal nominal loading does not by itself establish equal transfer, valid normalization, or quantitative comparability.",
        "source_ids": ["gilda-gomes-2013", "taylor-2013"]
      },
      {
        "claim": "A loading control must be validated for the experimental sample and treatment context rather than assumed to be invariant.",
        "source_ids": ["gilda-gomes-2013", "bass-2017"]
      },
      {
        "claim": "Quantitative interpretation requires evidence that target and normalization signals are measured within suitable response ranges and are not saturated.",
        "source_ids": ["taylor-2013"]
      },
      {
        "claim": "Antibody specificity and performance require application- and context-appropriate validation.",
        "source_ids": ["uhlen-2016"]
      }
    ],
    "sources": [
      {
        "id": "towbin-1979",
        "citation": "Towbin H, Staehelin T, Gordon J. Electrophoretic transfer of proteins from polyacrylamide gels to nitrocellulose sheets: procedure and some applications. Proc Natl Acad Sci U S A. 1979;76:4350–4354.",
        "doi": "10.1073/pnas.76.9.4350",
        "url": "https://pubmed.ncbi.nlm.nih.gov/388439/",
        "role": "Primary methodological evidence for membrane transfer, blocking, primary-antibody binding, labeled secondary detection, and the explicit warning that SDS-gel transfer was not quantitative in the reported conditions."
      },
      {
        "id": "bass-2017",
        "citation": "Bass JJ et al. An overview of technical considerations for Western blotting applications to physiological research. Scand J Med Sci Sports. 2017;27:4–25.",
        "doi": "10.1111/sms.12702",
        "url": "https://pubmed.ncbi.nlm.nih.gov/27263489/",
        "role": "Authoritative workflow review supporting the sequential assay stages and the need for quality control from sample preparation through detection and interpretation."
      },
      {
        "id": "taylor-2013",
        "citation": "Taylor SC, Berkelman T, Yadav G, Hammond M. A defined methodology for reliable quantification of Western blot data. Mol Biotechnol. 2013;55:217–226.",
        "doi": "10.1007/s12033-013-9672-6",
        "url": "https://pubmed.ncbi.nlm.nih.gov/23709336/",
        "role": "Methodological guidance supporting explicit linear-response, saturation, normalization, replicate, and statistical boundaries for quantitative claims."
      },
      {
        "id": "gilda-gomes-2013",
        "citation": "Gilda JE, Gomes AV. Stain-Free total protein staining is a superior loading control to β-actin for Western blots. Anal Biochem. 2013;440:186–188.",
        "doi": "10.1016/j.ab.2013.05.027",
        "url": "https://pubmed.ncbi.nlm.nih.gov/23747530/",
        "role": "Primary comparison supporting the separation of total-protein assessment from an unvalidated housekeeping-protein assumption."
      },
      {
        "id": "uhlen-2016",
        "citation": "Uhlén M et al. A proposal for validation of antibodies. Nat Methods. 2016;13:823–827.",
        "doi": "10.1038/nmeth.3995",
        "url": "https://pubmed.ncbi.nlm.nih.gov/27595404/",
        "role": "Consensus proposal supporting application-specific antibody validation and the boundary against inferring specificity from a single band depiction."
      }
    ],
    "design_precedents": [
      {
        "source_id": "bass-2017",
        "figure": "Figure 1 sequential process overview",
        "decision": "Use a numbered process sequence from sample handling through detection, with sample preparation, separation, transfer, probing, and detection kept as distinct editable stages."
      },
      {
        "source_id": "towbin-1979",
        "figure": "Experimental procedure",
        "decision": "Place membrane transfer before blocking and primary/secondary antibody probing and avoid any visual claim that transfer is complete or quantitative."
      },
      {
        "source_id": "gilda-gomes-2013",
        "figure": "Figure 1 loading-control comparison",
        "decision": "Show total-protein assessment before loading and label the loading-control band generically so authors must choose and validate an appropriate control."
      },
      {
        "source_id": "taylor-2013",
        "figure": "Quantification workflow",
        "decision": "Keep the result illustrative and place detector linearity, saturation, normalization, fold-change, replicate, and statistical interpretation outside the starter's claims."
      },
      {
        "source_id": "uhlen-2016",
        "figure": "Figure 1 antibody-validation strategies",
        "decision": "Use generic primary/secondary antibody placeholders and state that the scene does not establish antibody specificity."
      }
    ],
    "limitations": [
      "The depicted bands are editable placeholders, not experimental data.",
      "The loading-control placeholder must be replaced with a control validated for the sample type, treatment, target, and intended comparison.",
      "The scene does not establish detector linearity, absence of saturation, transfer efficiency, antibody specificity, normalization validity, or quantitative comparability.",
      "Band appearance does not support a fold-change, statistical-significance, biological-mechanism, or reproducibility claim.",
      "One illustrative blot alone is not a complete quantitative analysis; appropriate controls, response-range checks, independent biological replicates, transparent image handling, and statistical analysis remain the author's responsibility.",
      "Reagents, buffer chemistry, membrane type, molecular-mass markers, incubation conditions, wash steps, detection chemistry, species, cell type, tissue, treatment, and acquisition settings are intentionally generic or omitted."
    ],
    "authorship": "Original Figure Studio scene recipe and preview assembled from already released Figure Studio laboratory and assay assets plus original editable vector primitives; no publication artwork, commercial template, screenshot, database diagram, or third-party visual content was copied, traced, or embedded."
  },
