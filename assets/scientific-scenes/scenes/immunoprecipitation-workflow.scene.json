    "id": "science.figure-studio.immunoprecipitation-workflow.2026-11-03",
    "verified_on": "2026-11-03",
    "scope": "Antibody capture of a target from lysate, bead recovery, washing, and downstream analysis.",
    "relationships": [
      {
        "claim": "An antibody enriches its target from a prepared sample; co-immunoprecipitation can recover associated proteins when the complex survives extraction and washing.",
        "source_ids": [
          "immunoprecipitation-2020",
          "coip-kinase-2020"
        ]
      }
    ],
    "sources": [
      {
        "id": "immunoprecipitation-2020",
        "citation": "DeCaprio J, Kohl TO. Immunoprecipitation. Cold Spring Harb Protoc. 2020;2020(11):pdb.top098509.",
        "doi": "10.1101/pdb.top098509",
        "url": "https://pubmed.ncbi.nlm.nih.gov/33139503/",
        "support_location": "Abstract/introduction defining soluble antigen binding by an antigen-specific antibody and recovery of the immune complex on a solid-phase matrix. No figure is cited.",
        "decision": "Separate target recognition, solid-phase recovery, washing, and downstream detection. Leave the recovered protein composition unassigned; enrichment alone does not establish direct molecular contact."
      },
      {
        "id": "coip-kinase-2020",
        "citation": "Brian BF IV, Guerrero CR, Freedman TS. Immunopharmacology and Quantitative Analysis of Tyrosine Kinase Signaling. Curr Protoc Immunol. 2020;130(1):e104.",
        "doi": "10.1002/cpim.104",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7583487/",
        "support_location": "Basic Protocol 2, Enriching target proteins and isolation of protein complexes by immunoprecipitation; Support Protocol, Covalent conjugation of antibodies to functionalized beads.",
        "decision": "Separate target recognition, solid-phase recovery, washing, and downstream detection. Leave the recovered protein composition unassigned; enrichment alone does not establish direct molecular contact."
      }
    ],
    "limitations": [
      "Schematic only. Recovery is not proof of direct binding. Antibody specificity, lysis conditions, bead background, interaction stability, input, and immunoglobulin-chain interference require experiment-specific controls."
    ],
    "authorship": "Original editable scene composed from released Figure Studio assets and original vector/text objects; published figures informed scientific relationships only. No publication artwork was copied, traced, or embedded."
