  "id": "wound-closure-assay-workflow",
  "name": "Wound-closure assay workflow",
  "summary": "Create a cell-free gap, image matched fields over time, and quantify gap closure.",
  "source_record_id": "source.figure-studio-scene-expansion.2026-11-03",
  "rights_record_id": "rights.figure-studio-scene-expansion.repository-cc0.2026-11-03",
  "scientific_record": {
    "id": "science.figure-studio.wound-closure-assay-workflow.2026-11-03",
    "verified_on": "2026-11-03",
    "scope": "Create a cell-free gap, image matched fields over time, and quantify gap closure.",
    "relationships": [
      {
        "claim": "A gap in a confluent cell layer can be followed by microscopy to assess collective movement into the cleared area.",
        "source_ids": [
          "balko-2023",
          "jonkman-2014"
        ]
      }
    ],
    "sources": [
      {
        "id": "balko-2023",
        "citation": "Balko S et al. A Robust and Standardized Approach to Quantify Wound Closure Using the Scratch Assay. Methods and Protocols. 2023;6:87.",
        "doi": "10.3390/mps6050087",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10514857/",
        "support_location": "Methods describing scratch creation, matched image acquisition and wound-closure quantification.",
        "decision": "Keep the initial gap, repeated imaging of the same field, and gap measurement explicit. The schematic does not show closure trajectories or attribute closure exclusively to migration."
      },
      {
        "id": "jonkman-2014",
        "citation": "Jonkman JEN, Cathcart JA, Xu F, Bartolini ME, Amon JE, Stevens KM, Colarusso P. An introduction to the wound healing assay using live-cell microscopy. Cell Adhes Migr. 2014;8(5):440–451.",
        "doi": "10.4161/cam.36224",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC5154238/",
        "support_location": "Section IV, Microscope Configuration and Image Acquisition for the Wound Healing Assay; Figures 3–4 and 6 (microscope comparison, background correction, and time-series closure).",
        "decision": "Keep the initial gap, repeated imaging of the same field, and gap measurement explicit. The schematic does not show closure trajectories or attribute closure exclusively to migration."
      }
    ],
    "limitations": [
      "In vitro gap closure does not by itself isolate migration from proliferation, survival, or changes in cell spreading. Standardize gap geometry, image positions, and timing; interpret in the context of model and controls."
    ],
    "authorship": "Original editable scene composed from released Figure Studio assets and original vector/text objects; published figures informed scientific relationships only. No publication artwork was copied, traced, or embedded."
