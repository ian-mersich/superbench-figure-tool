{
  "schema": "figureStudio.scientificScene.v1",
  "id": "t-cell-activation-checkpoint",
  "name": "T-cell activation and PD-1 checkpoint",
  "summary": "Antigen recognition, CD28 co-stimulation, a compact TCR pathway, and one PD-1 inhibitory branch.",
  "source_record_id": "source.figure-studio-tcell-scientific-starter.2026-09-12",
  "rights_record_id": "rights.figure-studio-tcell-scientific-starter.cc0.2026-09-12",
  "scientific_record": {
    "id": "science.figure-studio.tcell-activation-checkpoint.2026-09-12",
    "verified_on": "2026-09-12",
    "scope": "A locally authored, editable overview of antigen-dependent TCR engagement, CD28 co-stimulation, selected proximal signaling, and one PD-1 inhibitory branch.",
    "relationships": [
      {
        "claim": "Peptide–MHC engagement of the TCR is represented upstream of LCK, ZAP-70, and LAT.",
        "source_ids": ["courtney-2018", "uniprot-zap70-p43403"]
      },
      {
        "claim": "CD28 engagement by B7-family ligands is represented as a co-stimulatory input that supports the activation program.",
        "source_ids": ["esensten-2016"]
      },
      {
        "claim": "PD-1 ligation is represented as recruiting SHP2 and preferentially attenuating CD28 signaling in the experimental contexts studied.",
        "source_ids": ["yokosuka-2012", "hui-2017"]
      }
    ],
    "sources": [
      {
        "id": "courtney-2018",
        "citation": "Courtney AH, Lo W-L, Weiss A. TCR Signaling: Mechanisms of Initiation and Propagation. Trends Biochem Sci. 2018;43:108–123.",
        "doi": "10.1016/j.tibs.2017.11.008",
        "url": "https://pubmed.ncbi.nlm.nih.gov/29269020/",
        "role": "Authoritative review of the TCR–LCK–ZAP-70–LAT signaling sequence."
      },
      {
        "id": "uniprot-zap70-p43403",
        "citation": "UniProtKB/Swiss-Prot P43403 (ZAP70_HUMAN), reviewed entry.",
        "url": "https://www.uniprot.org/uniprotkb/P43403/entry",
        "role": "Current authoritative protein annotation for ZAP-70 recruitment, LCK-dependent activation, and LAT phosphorylation."
      },
      {
        "id": "esensten-2016",
        "citation": "Esensten JH et al. CD28 costimulation: from mechanism to therapy. Immunity. 2016;44:973–988.",
        "doi": "10.1016/j.immuni.2016.04.020",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4932896/",
        "role": "Authoritative review supporting CD28 as a critical second signal alongside TCR ligation."
      },
      {
        "id": "yokosuka-2012",
        "citation": "Yokosuka T et al. Programmed cell death 1 forms negative costimulatory microclusters that directly inhibit T cell receptor signaling by recruiting phosphatase SHP2. J Exp Med. 2012;209:1201–1217.",
        "doi": "10.1084/jem.20112741",
        "url": "https://rupress.org/jem/article/209/6/1201/41299/Programmed-cell-death-1-forms-negative",
        "role": "Primary experimental evidence for PD-1 microclusters, SHP2 recruitment, and reduced proximal signaling."
      },
      {
        "id": "hui-2017",
        "citation": "Hui E et al. T cell costimulatory receptor CD28 is a primary target for PD-1-mediated inhibition. Science. 2017;355:1428–1433.",
        "doi": "10.1126/science.aaf1292",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6286077/",
        "role": "Primary biochemical and intact-cell evidence that CD28 is preferentially dephosphorylated by PD-1-recruited SHP2 in the tested systems."
      }
    ],
    "design_precedents": [
      {
        "source_id": "courtney-2018",
        "figure": "Figure 1B",
        "decision": "Separate receptor engagement from the compact LCK–ZAP-70–LAT sequence below the membrane."
      },
      {
        "source_id": "esensten-2016",
        "figure": "Conceptual pathway discussion",
        "decision": "Keep CD28–B7 co-stimulation visually parallel to antigen recognition instead of treating it as a downstream TCR node."
      },
      {
        "source_id": "yokosuka-2012",
        "figure": "Figures 6–8",
        "decision": "Use one restrained PD-1–SHP2 inhibitory branch and an inhibition-bar terminator."
      },
      {
        "source_id": "hui-2017",
        "figure": "Figures 2–3",
        "decision": "Place the inhibitory branch near CD28 and label the attenuation as preferential and context-bounded."
      }
    ],
    "limitations": [
      "This starter is not a complete T-cell signaling network.",
      "Relationships are qualitative summaries, not quantitative, stoichiometric, kinetic, temporal, or causal-inference claims.",
      "Spatial proximity in the starter does not claim molecular complex membership, simultaneous occupancy, or pathway equivalence.",
      "Cell type, differentiation state, ligand density, species, and experimental context can change signaling behavior.",
      "The activation-program output is an editable abstraction and is not a computable model or a claim that all downstream programs are equivalent."
    ],
    "authorship": "Original Figure Studio scene recipe and preview; no third-party artwork, database diagram, or commercial visual content was copied, traced, or embedded."
  },
