    "verified_on": "2026-11-03",
    "scope": "Capture antibody, sample antigen, detection antibody, enzyme signal, and calibrated readout.",
    "relationships": [
      {
        "claim": "Two antibodies recognize distinct epitopes of an analyte; an enzyme-linked detection system produces a measurable signal for comparison with standards.",
        "source_ids": [
          "gonzalez-2011",
          "kragstrup-2013"
        ]
      }
    ],
    "sources": [
      {
        "id": "gonzalez-2011",
        "citation": "Gonzalez RM et al. Development of a fibrinogen-specific sandwich enzyme-linked immunosorbent assay microarray assay for distinguishing between blood plasma and serum samples. Anal Biochem. 2011;414(1):99–102.",
        "doi": "10.1016/j.ab.2011.02.039",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3097095/",
        "support_location": "Methods: Antibody Source and Preparation and ELISA Microarray Processing; describes the capture and detection antibody configuration used in this assay.",
        "decision": "Show capture and detection as separate antibody-binding events, with standards carried into the readout. Do not invent a calibration curve or imply that antibody pairing is validated."
      },
      {
        "id": "kragstrup-2013",
        "citation": "Kragstrup TW et al. A simple set of validation steps identifies and removes false results in a sandwich enzyme-linked immunosorbent assay caused by anti-animal IgG antibodies in plasma from arthritis patients. SpringerPlus. 2013;2:263.",
        "doi": "10.1186/2193-1801-2-263",
        "url": "https://pubmed.ncbi.nlm.nih.gov/23875127/",
        "support_location": "Methods and Table 1; the assay describes capture and biotin-conjugated detection antibody, supporting explicit treatment of the downstream detection reagent.",
        "decision": "Show capture and detection as separate antibody-binding events, with standards carried into the readout. Do not invent a calibration curve or imply that antibody pairing is validated."
      }
    ],
    "limitations": [
      "Schematic only. No standard curve or concentrations are supplied. Antibody pairing, matrix effects, cross-reactivity, sample dilution, calibration range, and signal saturation must be assessed for the analyte and sample type."
    ],
    "authorship": "Original editable scene composed from released Figure Studio assets and original vector/text objects; published figures informed scientific relationships only. No publication artwork was copied, traced, or embedded."
