  "schema": "figureStudio.scientificScene.v1",
  "id": "hypothalamic-pituitary-adrenal-axis",
  "name": "Hypothalamic–pituitary–adrenal axis",
  "summary": "Stress-related hypothalamic drive, pituitary ACTH, adrenal glucocorticoid output, and negative feedback.",
  "source_record_id": "source.figure-studio-scene-expansion.2026-11-07",
  "rights_record_id": "rights.figure-studio-scene-expansion.repository-cc0.2026-11-07",
  "scientific_record": {
    "id": "science.figure-studio.hypothalamic-pituitary-adrenal-axis.2026-11-07",
    "verified_on": "2026-11-07",
    "scope": "Parvocellular hypothalamic neurons release CRH into the median eminence portal circulation. CRH stimulates anterior-pituitary corticotrophs to release ACTH, which stimulates glucocorticoid synthesis and release from the adrenal cortex. Glucocorticoids feed back to reduce hypothalamic and pituitary drive.",
    "relationships": [
      {
        "claim": "Parvocellular hypothalamic neurons release CRH into the median eminence portal circulation. CRH stimulates anterior-pituitary corticotrophs to release ACTH, which stimulates glucocorticoid synthesis and release from the adrenal cortex. Glucocorticoids feed back to reduce hypothalamic and pituitary drive.",
        "source_ids": [
          "hpa-guide",
          "hpa-feedback-primary"
        ]
      }
    ],
    "sources": [
      {
        "id": "hpa-guide",
        "citation": "Spencer RL, Deak T. A user's guide to HPA axis research. Physiol Behav. 2017;178:43–65. doi:10.1016/j.physbeh.2016.11.014.",
        "doi": "10.1016/j.physbeh.2016.11.014",
        "url": "https://pubmed.ncbi.nlm.nih.gov/27871862/",
        "support_location": "Overview of hypothalamic CRH, pituitary ACTH, adrenal glucocorticoid secretion, and glucocorticoid feedback.",
        "decision": "Use three anatomically ordered endocrine stations with portal CRH delivery to the anterior pituitary and circulating ACTH to the adrenal cortex."
      },
      {
        "id": "hpa-feedback-primary",
        "citation": "Osterlund CD, Rodriguez-Santiago M, Woodruff ER, Newsom RJ, Chadayammuri AP, Spencer RL. Glucocorticoid fast feedback inhibition of stress-induced ACTH secretion in the male rat: rate independence and stress-state resistance. Endocrinology. 2016;157(7):2785–2798. doi:10.1210/en.2016-1123.",
        "doi": "10.1210/en.2016-1123",
        "url": "https://pubmed.ncbi.nlm.nih.gov/27145013/",
        "support_location": "Rat in-vivo corticosterone infusion experiments show feedback inhibition of stress-induced ACTH and CRH responses, supporting qualitative upstream inhibitory links.",
        "decision": "Show glucocorticoid feedback to both hypothalamic drive and pituitary corticotroph output with dashed inhibition-bar connectors; the marks denote qualitative inhibition, not quantitative strength."
      }
    ],
    "design_precedents": [
      {
        "source_id": "hpa-guide",
        "figure": "Methods / conceptual figure",
        "decision": "Use three anatomically ordered endocrine stations with portal CRH delivery to the anterior pituitary and circulating ACTH to the adrenal cortex."
      },
      {
        "source_id": "hpa-feedback-primary",
        "figure": "Methods / conceptual figure",
        "decision": "Show glucocorticoid feedback to both hypothalamic drive and pituitary corticotroph output with dashed inhibition-bar connectors; the marks denote qualitative inhibition, not quantitative strength."
      }
    ],
    "limitations": [
      "Qualitative overview. Vasopressin co-drive, circadian and ultradian dynamics, species-specific glucocorticoids, and distributed neural inputs are not resolved; the diagram does not predict hormone concentrations or response timing."
    ],
    "authorship": "Original editable scene composed from native vector/text objects and original endocrine asset placeholders. Published research informed biological claims and design decisions only; no publication artwork was copied, traced, or embedded."
  },
