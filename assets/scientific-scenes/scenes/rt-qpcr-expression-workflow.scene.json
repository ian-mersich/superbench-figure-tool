    "relationships": [
      {
        "claim": "RT-qPCR measures target amplification after RNA is converted to cDNA; interpretation depends on assay performance and validated normalization.",
        "source_ids": [
          "bustin-2009",
          "bustin-2010"
        ]
      }
    ],
    "sources": [
      {
        "id": "bustin-2009",
        "citation": "Bustin SA et al. The MIQE guidelines: minimum information for publication of quantitative real-time PCR experiments. Clinical Chemistry. 2009;55:611–622.",
        "doi": "10.1373/clinchem.2008.112797",
        "url": "https://pubmed.ncbi.nlm.nih.gov/19246619/",
        "support_location": "MIQE checklist and article text on RNA quality, reverse transcription, assay performance, controls and normalization.",
        "decision": "Show RNA-to-cDNA conversion, the target/reference assay, and negative controls as distinct steps; leave all amplification traces and relative-expression results blank because they depend on the user's assay and data."
      },
      {
        "id": "bustin-2010",
        "citation": "Bustin SA et al. MIQE précis: Practical implementation of minimum standard guidelines for fluorescence-based quantitative real-time PCR experiments. BMC Molecular Biology. 2010;11:74.",
        "doi": "10.1186/1471-2199-11-74",
        "url": "https://pubmed.ncbi.nlm.nih.gov/20858237/",
        "support_location": "MIQE précis checklist and practical assay-validation guidance.",
        "decision": "Show RNA-to-cDNA conversion, the target/reference assay, and negative controls as distinct steps; leave all amplification traces and relative-expression results blank because they depend on the user's assay and data."
      }
    ],
    "limitations": [
      "Schematic only. No amplification curves, expression values, fold changes, or significance are shown. Validate RNA, primer specificity, efficiency, controls, and reference genes for the experiment."
