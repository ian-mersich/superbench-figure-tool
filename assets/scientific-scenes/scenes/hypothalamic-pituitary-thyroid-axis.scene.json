  "schema": "figureStudio.scientificScene.v1",
  "id": "hypothalamic-pituitary-thyroid-axis",
  "name": "Hypothalamic–pituitary–thyroid axis",
  "summary": "Hypothalamic TRH drives pituitary TSH and thyroid follicular T4/T3 output under feedback control.",
  "source_record_id": "source.figure-studio-scene-expansion.2026-11-07",
  "rights_record_id": "rights.figure-studio-scene-expansion.repository-cc0.2026-11-07",
  "scientific_record": {
    "id": "science.figure-studio.hypothalamic-pituitary-thyroid-axis.2026-11-07",
    "verified_on": "2026-11-07",
    "scope": "Hypothalamic TRH stimulates pituitary thyrotrophs to release TSH. TSH stimulates thyroid follicular synthesis and secretion of T4 and T3. Thyroid hormones reduce upstream TRH and TSH synthesis or secretion through feedback at hypothalamic and pituitary levels.",
    "relationships": [
      {
        "claim": "Hypothalamic TRH stimulates pituitary thyrotrophs to release TSH. TSH stimulates thyroid follicular synthesis and secretion of T4 and T3. Thyroid hormones reduce upstream TRH and TSH synthesis or secretion through feedback at hypothalamic and pituitary levels.",
        "source_ids": [
          "hpt-primary",
          "hpt-pituitary"
        ]
      }
    ],
    "sources": [
      {
        "id": "hpt-primary",
        "citation": "Segerson TP et al. Thyroid hormone regulates TRH biosynthesis in the paraventricular nucleus of the rat hypothalamus. Science. 1987;238(4823):78–80. doi:10.1126/science.3116669.",
        "doi": "10.1126/science.3116669",
        "url": "https://pubmed.ncbi.nlm.nih.gov/3116669/",
        "support_location": "Rat thyroid-hormone manipulation experiments show reduced hypothalamic proTRH mRNA, supporting feedback from thyroid hormone to the TRH-producing hypothalamic population.",
        "decision": "Distinguish TRH delivery through the median eminence from circulating TSH action on a thyroid follicle; label the glandular products as T4 and T3."
      },
      {
        "id": "hpt-pituitary",
        "citation": "Samuels MH, Wierman A, Wang C, Ridgway EC. The effect of altered thyroid status on pituitary hormone messenger ribonucleic acid concentrations in the rat. Endocrinology. 1989;124(5):2277–2282.",
        "doi": "10.1210/endo-124-5-2277",
        "url": "https://pubmed.ncbi.nlm.nih.gov/2495926/",
        "support_location": "Rat thyroid-status experiments measured pituitary TSH-subunit expression and support thyroid-hormone feedback at the pituitary level.",
        "decision": "Route thyroid-hormone feedback separately to hypothalamic TRH neurons and pituitary thyrotrophs using dashed inhibition bars. The follicle is shown as an endocrine source, not a histological micrograph."
      }
    ],
    "design_precedents": [
      {
        "source_id": "hpt-primary",
        "figure": "Methods / conceptual figure",
        "decision": "Distinguish TRH delivery through the median eminence from circulating TSH action on a thyroid follicle; label the glandular products as T4 and T3."
      },
      {
        "source_id": "hpt-pituitary",
        "figure": "Methods / conceptual figure",
        "decision": "Route thyroid-hormone feedback separately to hypothalamic TRH neurons and pituitary thyrotrophs using dashed inhibition bars. The follicle is shown as an endocrine source, not a histological micrograph."
      }
    ],
    "limitations": [
      "Qualitative overview. It omits local deiodinase activity, transport and binding proteins, iodine availability, illness-related regulation, and the distinct kinetics of TSH and thyroid hormones. No diagnostic reference ranges or concentrations are implied."
    ],
