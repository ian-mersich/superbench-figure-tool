{
  "schema": "figureStudio.scientificScene.v1",
  "id": "autophagosome-lysosome-process",
  "name": "Autophagosome–lysosome process",
  "summary": "A qualitative macroautophagy sequence from phagophore formation and selected cargo capture through autophagosome closure, lysosomal fusion, and cargo degradation.",
  "source_record_id": "source.figure-studio-autophagosome-lysosome-process.2026-09-13",
  "rights_record_id": "rights.figure-studio-autophagosome-lysosome-process.cc0.2026-09-13",
  "scientific_record": {
    "id": "science.figure-studio.autophagosome-lysosome-process.2026-09-13",
    "verified_on": "2026-09-13",
    "scope": "A locally authored, editable orientation schematic of selected mammalian macroautophagy stages from an open phagophore to lysosomal degradation.",
    "relationships": [
      {
        "claim": "A phagophore expands around cytoplasmic material, closes as a double-membrane autophagosome, and can fuse with a lysosome to form an autolysosome where sequestered material is degraded.",
        "source_ids": ["mizushima-komatsu-2011", "itakura-2012"]
      },
      {
        "claim": "Processed, lipidated LC3 is represented on selected phagophore and autophagosome membranes as a membrane-associated marker, not as a quantitative readout.",
        "source_ids": ["kabeya-2000", "klionsky-2021"]
      },
      {
        "claim": "SQSTM1/p62 is shown only as one cargo-receptor example that can bind LC3 and ubiquitinated protein cargo and can itself be delivered for autophagic degradation.",
        "source_ids": ["pankiv-2007", "klionsky-2021"]
      },
      {
        "claim": "A static arrangement of LC3, SQSTM1/p62, autophagosomes, or autolysosomes cannot establish autophagic flux without appropriate turnover or lysosomal-blockade comparisons.",
        "source_ids": ["klionsky-2021"]
      }
    ],
    "sources": [
      {
        "id": "mizushima-komatsu-2011",
        "citation": "Mizushima N, Komatsu M. Autophagy: renovation of cells and tissues. Cell. 2011;147:728–741.",
        "doi": "10.1016/j.cell.2011.10.026",
        "url": "https://pubmed.ncbi.nlm.nih.gov/22078875/",
        "role": "Authoritative review supporting the qualitative sequence from cargo sequestration through lysosomal degradation and recycling."
      },
      {
        "id": "kabeya-2000",
        "citation": "Kabeya Y et al. LC3, a mammalian homologue of yeast Apg8p, is localized in autophagosome membranes after processing. EMBO J. 2000;19:5720–5728.",
        "doi": "10.1093/emboj/19.21.5720",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC305793/",
        "role": "Primary experimental evidence supporting restrained LC3 membrane cues on phagophores and autophagosomes."
      },
      {
        "id": "pankiv-2007",
        "citation": "Pankiv S et al. p62/SQSTM1 binds directly to Atg8/LC3 to facilitate degradation of ubiquitinated protein aggregates by autophagy. J Biol Chem. 2007;282:24131–24145.",
        "doi": "10.1074/jbc.M702824200",
        "url": "https://pubmed.ncbi.nlm.nih.gov/17580304/",
        "role": "Primary biochemical and cell evidence supporting one SQSTM1/p62-linked ubiquitinated-cargo example."
      },
      {
        "id": "itakura-2012",
        "citation": "Itakura E, Kishi-Itakura C, Mizushima N. The hairpin-type tail-anchored SNARE syntaxin 17 targets to autophagosomes for fusion with endosomes/lysosomes. Cell. 2012;151:1256–1269.",
        "doi": "10.1016/j.cell.2012.11.001",
        "url": "https://pubmed.ncbi.nlm.nih.gov/23217709/",
        "role": "Primary evidence that completed autophagosomes, rather than open isolation membranes, become competent for lysosomal fusion. The starter does not depict the complete fusion machinery."
      },
      {
        "id": "klionsky-2021",
        "citation": "Klionsky DJ et al. Guidelines for the use and interpretation of assays for monitoring autophagy (4th edition). Autophagy. 2021;17:1–382.",
        "doi": "10.1080/15548627.2020.1797280",
        "url": "https://pubmed.ncbi.nlm.nih.gov/33634751/",
        "role": "Consensus guidance supporting the explicit boundary between static marker or compartment depictions and experimental measurement of autophagic flux."
      }
    ],
    "design_precedents": [
      {
        "source_id": "mizushima-komatsu-2011",
        "figure": "Figure 1 overview",
        "decision": "Use a left-to-right organelle sequence with phagophore, closed autophagosome, lysosomal fusion, and autolysosomal degradation as distinct stages."
      },
      {
        "source_id": "kabeya-2000",
        "figure": "Figures 3–5",
        "decision": "Use sparse LC3 membrane dots as a marker cue without implying puncta counts, concentration, or flux."
      },
      {
        "source_id": "pankiv-2007",
        "figure": "Figures 5–7",
        "decision": "Keep SQSTM1/p62 beside one selected cargo example and connect it to LC3 rather than presenting p62 as universal cargo."
      },
      {
        "source_id": "itakura-2012",
        "figure": "Figure 7 model",
        "decision": "Place fusion after membrane closure and keep the unspecified fusion step visually separate from the earlier phagophore."
      },
      {
        "source_id": "klionsky-2021",
        "figure": "Assay-interpretation overview",
        "decision": "Give the static-versus-flux limitation a persistent, visible position beneath the process."
      }
    ],
    "limitations": [
      "This starter is a qualitative macroautophagy orientation schematic, not a complete or canonical pathway map.",
      "The depicted sequence is not a measurement of autophagic flux; LC3, SQSTM1/p62, compartment abundance, or morphology at one time point cannot establish delivery and turnover rates.",
      "Relationships are not quantitative, stoichiometric, kinetic, temporal-resolution, or causal-inference claims.",
      "SQSTM1/p62 is one selected ubiquitinated-cargo receptor example and does not represent all selective or nonselective autophagy cargo capture.",
      "Membrane sources, ATG machinery, fusion proteins, lysosomal enzymes, recycling routes, organelle contacts, cell type, species, stimulus, and experimental context are intentionally incomplete or unspecified.",
      "The scene makes no disease-specific causal, therapeutic-response, biomarker, diagnostic, prognostic, or clinical claim."
    ],
    "authorship": "Original Figure Studio scene recipe and preview assembled from already released Figure Studio organelle assets and original editable vector primitives; no publication artwork, database diagram, commercial illustration, screenshot, or third-party visual content was copied, traced, or embedded."
  },
