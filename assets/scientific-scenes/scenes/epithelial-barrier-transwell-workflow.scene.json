  "schema": "figureStudio.scientificScene.v1",
  "id": "epithelial-barrier-transwell-workflow",
  "name": "Epithelial barrier Transwell assay",
  "summary": "Grow a polarized epithelial layer on a porous insert and pair electrical and tracer-flux readouts.",
  "source_record_id": "source.figure-studio-scene-expansion.2026-11-03",
  "rights_record_id": "rights.figure-studio-scene-expansion.repository-cc0.2026-11-03",
  "scientific_record": {
    "id": "science.figure-studio.epithelial-barrier-transwell-workflow.2026-11-03",
    "verified_on": "2026-11-03",
    "scope": "Grow a polarized epithelial layer on a porous insert and pair electrical and tracer-flux readouts.",
    "relationships": [
      {
        "claim": "An epithelial monolayer separates apical and basolateral compartments; TEER reports ionic conductance while tracer passage measures permeability to the chosen tracer.",
        "source_ids": [
          "pell-2021",
          "keser-2026"
        ]
      }
    ],
    "sources": [
      {
        "id": "pell-2021",
        "citation": "Pell TJ et al. Epithelial Barrier Integrity Profiling: Combined Approach Using Cellular Junctional Complex Imaging and Transepithelial Electrical Resistance. SLAS Discov. 2021;26(7):909–921.",
        "doi": "10.1177/24725552211013077",
        "url": "https://pubmed.ncbi.nlm.nih.gov/34085560/",
        "support_location": "Methods section, TEER and Data Analysis.",
        "decision": "Pair the nondestructive electrical readout with a separate directional tracer-flux step, showing apical and basolateral compartments without equating resistance with macromolecule permeability."
      },
      {
        "id": "keser-2026",
        "citation": "Keser Y, Boulant S, Stanifer ML. Assessment of Epithelial Barrier Integrity by TEER and FITC-Dextran Permeability Assays. Bio-protocol. 2026;16(8):e5673.",
        "doi": "10.21769/BioProtoc.5673",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC13180708/",
        "support_location": "Methods sections D, TEER measurement procedure, and E, FITC-dextran permeability assay; Figure 3 graphical workflow overview. The method adds tracer apically and quantifies fluorescence in the basolateral receiver after incubation.",
        "decision": "Pair the nondestructive electrical readout with a separate directional tracer-flux step, showing apical and basolateral compartments without equating resistance with macromolecule permeability."
      }
    ],
    "limitations": [
      "The two readouts are complementary and not interchangeable. TEER does not measure macromolecule flux; tracer results depend on tracer size, sampling, membrane, model, and assay conditions. A Transwell is an in-vitro model, not an intact organ barrier."
    ],
    "authorship": "Original editable scene composed from released Figure Studio assets and original vector/text objects; published figures informed scientific relationships only. No publication artwork was copied, traced, or embedded."
  },
