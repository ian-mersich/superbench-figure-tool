{
  "schema": "figureStudio.scientificScene.v1",
  "id": "glucose-islet-feedback",
  "name": "Glucose–islet insulin feedback",
  "summary": "Rising extracellular glucose stimulates islet insulin release, promoting peripheral uptake and restraining hepatic glucose output.",
  "source_record_id": "source.figure-studio-scene-expansion.2026-11-07",
  "rights_record_id": "rights.figure-studio-scene-expansion.repository-cc0.2026-11-07",
  "scientific_record": {
    "id": "science.figure-studio.glucose-islet-feedback.2026-11-07",
    "verified_on": "2026-11-07",
    "scope": "Elevated glucose stimulates insulin secretion from pancreatic islet β cells. Insulin promotes glucose uptake in insulin-responsive peripheral tissues and suppresses endogenous hepatic glucose production, tending to lower circulating glucose.",
    "relationships": [
      {
        "claim": "Elevated glucose stimulates insulin secretion from pancreatic islet β cells. Insulin promotes glucose uptake in insulin-responsive peripheral tissues and suppresses endogenous hepatic glucose production, tending to lower circulating glucose.",
        "source_ids": [
          "islet-human",
          "insulin-human"
        ]
      }
    ],
    "sources": [
      {
        "id": "islet-human",
        "citation": "Rodriguez-Diaz R et al. Paracrine interactions within the pancreatic islet determine the glycemic set point. Cell Metab. 2018;27(3):549–558.e4. doi:10.1016/j.cmet.2018.01.015.",
        "doi": "10.1016/j.cmet.2018.01.015",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC5860066/",
        "support_location": "Primary human-islet experiments on intra-islet paracrine signaling and glucose regulation; this schematic limits itself to glucose-responsive insulin and does not imply a universal set point.",
        "decision": "Use primary human-islet evidence to orient elevated extracellular glucose upstream of islet insulin release."
      },
      {
        "id": "insulin-human",
        "citation": "Campbell PJ, Mandarino LJ, Gerich JE. Quantification of the relative impairment in actions of insulin on hepatic glucose production and peripheral glucose uptake in non-insulin-dependent diabetes mellitus. Metabolism. 1988;37(1):15–21. doi:10.1016/0026-0495(88)90023-6.",
        "doi": "10.1016/0026-0495(88)90023-6",
        "url": "https://pubmed.ncbi.nlm.nih.gov/3275857/",
        "support_location": "Human glucose-clamp and isotope-flux study measured insulin-mediated suppression of hepatic glucose production and stimulation of peripheral glucose uptake; effects vary with diabetes status and insulin concentration.",
        "decision": "Represent insulin's actions as separate branches to peripheral glucose uptake and lower endogenous hepatic glucose production, as measured in human clamp studies; converge the branches on a qualitative lower-glucose outcome without implying universal rates."
      }
    ],
    "design_precedents": [
      {
        "source_id": "islet-human",
        "figure": "Methods / conceptual figure",
        "decision": "Use primary human-islet evidence to orient elevated extracellular glucose upstream of islet insulin release."
      },
      {
        "source_id": "insulin-human",
        "figure": "Methods / conceptual figure",
        "decision": "Represent insulin's actions as separate branches to peripheral glucose uptake and lower endogenous hepatic glucose production, as measured in human clamp studies; converge the branches on a qualitative lower-glucose outcome without implying universal rates."
      }
    ],
    "limitations": [
      "Qualitative conceptual loop. Insulin action varies by tissue, nutritional state, species, and disease context; glucose uptake is not uniform across all tissues. Glucagon and other hormones are omitted, and no universal set point or response rate is shown."
    ],
    "authorship": "Original editable scene composed from native vector/text objects and original endocrine asset placeholders. Published research informed biological claims and design decisions only; no publication artwork was copied, traced, or embedded."
  },
