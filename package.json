    "qa:native-pdf-quote-text-run": "py -3 scripts/check-native-pdf-text-run-edit-browser.py --operator quote",
    "qa:native-pdf-double-quote-text-run": "py -3 scripts/check-native-pdf-text-run-edit-browser.py --operator double-quote",
    "qa:native-pdf-form-text-run": "py -3 scripts/check-native-pdf-form-text-run-edit-browser.py",
    "qa:native-pdf-nested-form-text-run": "py -3 scripts/check-native-pdf-nested-form-text-run-edit-browser.py",
