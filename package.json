    "qa:adaptive-authoring": "py -3 scripts/check-adaptive-authoring-browser.py",
    "qa:dockable-rails": "py -3 scripts/check-dockable-side-rails-browser.py",
    "qa:panel-workspaces": "py -3 scripts/check-dockable-side-rails-browser.py",
