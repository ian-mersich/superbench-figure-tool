    "qa:deck-multi-master": "py -3 scripts/check-deck-multi-master-browser.py",
    "qa:scientific-annotations": "py -3 scripts/check-scientific-annotations-browser.py",
    "qa:appearance-stack": "py -3 scripts/check-appearance-stack-browser.py",
