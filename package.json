    "qa:layout-aids": "py -3 scripts/check-precision-layout-aids-browser.py",
    "qa:precision-tools": "py -3 scripts/check-precision-tools-browser.py",
    "qa:typography": "py -3 scripts/check-live-typography-browser.py",
    "qa:typography-hardening": "py -3 scripts/check-typography-hardening-browser.py",
