    "qa:compound-clipping": "py -3 scripts/check-compound-clipping-authoring-browser.py",
    "qa:pdf-qa-adapter": "py -3 scripts/test-pdf-qa-adapter.py",
    "qa:pdf-runtime-retirement": "py -3 scripts/check-pdf-runtime-retirement.py",
    "qa:pdf-entry-clarity": "py -3 scripts/test-pdf-entry-clarity.py && py -3 scripts/check-pdf-entry-clarity-browser.py",
    "qa:pdf-entry-page-scope": "py -3 scripts/test-pdf-entry-page-scope.py && py -3 scripts/check-pdf-entry-page-scope-browser.py",
    "qa:pdf-entry-preflight": "py -3 scripts/test-pdf-entry-preflight.py && py -3 scripts/check-pdf-entry-preflight-browser.py",
    "qa:pdf-entry-page-geometry": "py -3 scripts/test-pdf-entry-page-geometry.py && py -3 scripts/check-pdf-entry-page-geometry-browser.py",
